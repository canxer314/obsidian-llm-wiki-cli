# 复制到 ~/.config/sandcastle/env，填写 GH_TOKEN，然后运行：chmod 600 ~/.config/sandcastle/env
# 此处非空的配置会覆盖从 ~/.claude/settings.json 读取的白名单配置。

# 仅限本仓库的 fine-grained PAT。不要授予 Workflows write。
# 所需权限：Metadata read；Contents、Issues、Pull requests、Commit statuses read/write。
GH_TOKEN=

# 可选的 CC-Switch 路由和认证覆盖。通常从 Claude Code 设置读取。
# ANTHROPIC_BASE_URL=http://127.0.0.1:3456
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_DEFAULT_OPUS_MODEL=
# HTTP_PROXY=${HTTP_PROXY}
# HTTPS_PROXY=${HTTPS_PROXY}
# NO_PROXY=${NO_PROXY}
# 也分别支持小写的 http_proxy、https_proxy 和 no_proxy。

# 公开编排使用 Claude Code 别名；provider 专用映射保留在此文件中。
# SANDCASTLE_MODEL=opus
# SANDCASTLE_PLANNER_MODEL=
# SANDCASTLE_IMPLEMENTER_MODEL=
# SANDCASTLE_REVIEWER_MODEL=
