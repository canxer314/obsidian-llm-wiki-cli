# Anthropic Messages-compatible gateway used by Claude Code in the sandbox.
ANTHROPIC_BASE_URL=
# Bearer credential expected by the gateway.
ANTHROPIC_AUTH_TOKEN=

# Optional model mappings when the gateway uses Claude aliases.
ANTHROPIC_DEFAULT_FABLE_MODEL=
ANTHROPIC_DEFAULT_FABLE_MODEL_NAME=
CLAUDE_CODE_SUBAGENT_MODEL=

# Context budget for the custom gateway model. Keep the compact threshold below
# the real limit to reserve space for output and token-counting differences.
CLAUDE_CODE_MAX_CONTEXT_TOKENS=372000
CLAUDE_CODE_AUTO_COMPACT_WINDOW=340000

# Optional local proxy used by dependency installation inside the sandbox.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# Keep AFK containers from sending nonessential telemetry and update traffic.
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
