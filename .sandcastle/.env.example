# Copy to .sandcastle/.env, fill GH_TOKEN, then run: chmod 600 .sandcastle/.env
# Non-empty values here override whitelisted values read from ~/.claude/settings.json.

# Fine-grained PAT limited to this repository. Do not grant Workflows write.
# Required: Metadata read; Contents, Issues, Pull requests, Commit statuses read/write.
GH_TOKEN=

# Optional CC-Switch route/auth overrides. Usually read from Claude Code settings.
# ANTHROPIC_BASE_URL=http://127.0.0.1:3456
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_DEFAULT_OPUS_MODEL=
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# Public orchestration uses Claude Code aliases; provider-specific mappings stay here.
# SANDCASTLE_MODEL=opus
# SANDCASTLE_PLANNER_MODEL=
# SANDCASTLE_IMPLEMENTER_MODEL=
# SANDCASTLE_REVIEWER_MODEL=
