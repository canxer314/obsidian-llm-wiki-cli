# Sandcastle architecture review Automation Command (manual or scheduled).
# Version-controlled template, not an installed unit; deploy exactly like
# sandcastle-dispatch.service (see that file and the runbook). Shipped
# disabled: merging or copying this file never starts the write path.

[Unit]
Description=Sandcastle architecture review Automation Command

[Service]
Type=oneshot
# Trusted local repository checkout (clean, fast-forwarded master required).
WorkingDirectory=%h/repos/obsidian-llm-wiki-cli
# Node 24 (type stripping) running from trusted master; no build or install step.
ExecStart=%h/.nvm/versions/node/v24.19.0/bin/node --experimental-strip-types .sandcastle/main.ts architecture-review
# The operation has its own time limit; the unit must not cut it.
TimeoutStartSec=0
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
# No credentials here: GH_TOKEN, Claude routing/auth, and WSL proxy settings
# come from ~/.claude/settings.json and the protected private environment file
# (~/.config/sandcastle/env, mode 0600). Artifacts stay under .sandcastle/jobs/;
# operation output goes to the systemd journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sandcastle-architecture-review
