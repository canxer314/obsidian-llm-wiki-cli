{
  "$id": "https://canxer314.github.io/obsidian-llm-wiki-cli/contracts/v1/vault-read.input.schema.json",
  "title": "vault_read v1 input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "metadata"
            },
            "path": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "outline"
            },
            "path": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "section"
            },
            "path": {
              "$ref": "#/$defs/__schema1"
            },
            "hierarchy": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              }
            },
            "occurrence": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "path",
            "hierarchy",
            "occurrence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "exact"
            },
            "path": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema1": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*\\\\)(?!.*\\x00)(?!.*(?:^|\\/)(?:\\.{1,2})(?:\\/|$))(?!.*\\/\\/).+\\.md$"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    }
  }
}
