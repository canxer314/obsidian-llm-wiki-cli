{
  "input": {
    "query": {
      "all": [
        { "path": { "prefix": "Projects/" } },
        { "text": { "literal": "Design", "caseSensitive": true } },
        { "frontmatter": { "key": "status", "equals": "active" } },
        { "tag": { "exact": "#architecture" } },
