    "order": { "by": "path", "direction": "asc" },
    "page": { "maxItems": 100, "continuation": null }
  },
  "result": {
    "outcome": "results",
    "ordering": {
      "by": "path",
      "direction": "asc",
      "tieBreaker": "path_utf8_bytes"
    },
    "items": [
      {
