{
  "name": "obsidian-llm-wiki-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @llm-wiki/vault-contracts && npm run build -w @llm-wiki/obsidian-vault-bridge",
    "sandcastle": "node --experimental-strip-types .sandcastle/main.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p .sandcastle/tsconfig.json",
    "test": "vitest run --exclude '.claude/**' --exclude '.sandcastle/jobs/**' --exclude '.sandcastle/worktrees/**' --exclude '.sandcastle/recovered/**'",
    "test:watch": "vitest",
    "test:sandbox": "bash .sandcastle/smoke-test.sh"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
